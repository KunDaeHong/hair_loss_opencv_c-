{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug OpenCV App (macOS)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          //"value": "/usr/local/lib"
          "value": "${workspaceFolder}/Libraries/install/lib"
        }
      ],
      "MIMode": "lldb",
      // "miDebuggerPath": "/usr/bin/lldb",
      // "setupCommands": [
      //   {
      //     "description": "Enable pretty-printing for lldb",
      //     "text": "-enable-pretty-printing",
      //     "ignoreFailures": true
      //   }
      // ],
      "preLaunchTask": "C/C++: clang++ Build with OpenCV (macOS)"
    },

    {
      "name": "Debug OpenCV App with CMake (macOS)",
      "externalConsole": true,
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Bayabas_bald_detector_module",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "lldb",
      "preLaunchTask": "C/C++: clang++ Build with OpenCV, Cmake (macOS)"
    }
  ]
}
